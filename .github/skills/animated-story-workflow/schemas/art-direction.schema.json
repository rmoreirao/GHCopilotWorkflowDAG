{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "art-direction.schema.json",
  "title": "Art direction",
  "type": "object",
  "required": ["schemaVersion", "styleName", "originalityNotes", "palette", "materials", "scenes"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "styleName": { "type": "string", "minLength": 1 },
    "originalityNotes": { "type": "string", "minLength": 1 },
    "palette": {
      "type": "object",
      "minProperties": 3,
      "additionalProperties": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" }
    },
    "materials": {
      "type": "array",
      "minItems": 1,
      "items": { "enum": ["css-shape", "dom-layer", "gradient", "text", "generated-pattern"] },
      "uniqueItems": true
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["sceneId", "composition", "visualElements", "motion"],
        "additionalProperties": false,
        "properties": {
          "sceneId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "composition": { "type": "string", "minLength": 1 },
          "visualElements": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "motion": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      }
    }
  }
}
